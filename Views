<script>
  function filterHistoryProcData() {
    const query = document.getElementById('historyProcSearchInput').value.toLowerCase();
    const rows = document.getElementById('historyProcTableBody').getElementsByTagName('tr');
    let visibleCount = 0;
    
    for (let row of rows) {
      if (row.innerText.toLowerCase().includes(query)) {
        row.style.display = "";
        visibleCount++;
      } else {
        row.style.display = "none";
      }
    }
    document.getElementById('historyProcTotalCount').innerText = visibleCount;
  }

  function openHistoryProcModal() { document.getElementById('historyProcModal').classList.remove('hidden'); }
  function closeHistoryProcModal() { document.getElementById('historyProcModal').classList.add('hidden'); }

  function loadProcTrackingDirect() {
    google.script.run
      .withSuccessHandler(function(data) {
        
        let summaryData = [];
        if (data && data.summary) {
          summaryData = data.summary;        
        } else {
          summaryData = data; 
        }

        const tableBody = document.getElementById('historyProcTableBody');
        if (tableBody && summaryData && summaryData.length > 0) {
          
          document.getElementById('historyProcTotalCount').innerText = summaryData.length;

          tableBody.innerHTML = summaryData.map(item => {
            const dateToShow = item.date || item.lastUpdate || '-';
            const isFinished = item.maxIndex === 6;
            const pct = Math.round(((item.maxIndex + 1) / 7) * 100);
            
            // ใช้ SVG Icon แทน Emoji
            let statusBadge = '';
            if (isFinished) {
              statusBadge = `
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-700 border border-emerald-200">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  เสร็จสิ้น
                </span>
              `;
            } else {
              statusBadge = `
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] font-bold bg-blue-100 text-blue-700 border border-blue-200">
                  <svg class="w-3.5 h-3.5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  ${item.stepName}
                </span>
              `;
            }
            
            return `
              <tr class="hover:bg-slate-50 transition-colors group">
                <td class="py-3.5 px-2 text-slate-600 font-medium text-[12px]">${dateToShow}</td>
                <td class="py-3.5 px-2">
                  <span class="text-slate-600 font-mono text-[11px] font-semibold tracking-tight bg-slate-100 px-2 py-1 rounded border border-slate-200">${item.bookId || '-'}</span>
                </td>
                <td class="py-3.5 px-2 font-semibold text-slate-800 text-[13px] max-w-sm truncate" title="${item.title}">${item.title}</td>
                
                <td class="py-3.5 px-2">
                  <div class="flex items-center gap-3">
                    <div class="w-full bg-slate-200 rounded-full h-1 overflow-hidden">
                      <div class="bg-${isFinished ? 'emerald' : 'blue'}-600 h-1 rounded-full transition-all duration-500" style="width: ${pct}%"></div>
                    </div>
                    <span class="text-[11px] text-slate-600 font-bold w-6 text-right">${pct}%</span>
                  </div>
                </td>

                <td class="py-3.5 px-2 text-right">
                  ${statusBadge}
                </td>
              </tr>
            `;
          }).join('');
        } else if (tableBody) {
          document.getElementById('historyProcTotalCount').innerText = "0";
