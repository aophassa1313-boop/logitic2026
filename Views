        // การ์ดหน้าหลัก
        const container = document.getElementById('procurementProgressContainer');
        if (!summaryData || summaryData.length === 0) {
          container.innerHTML = '<div class="text-center text-slate-500 py-4 text-sm font-medium">ยังไม่มีรายการที่กำลังดำเนินการ</div>';
          return;
        }

        container.innerHTML = summaryData.map(item => {
          const isFinished = item.maxIndex === 6;
          const progressPercent = ((item.maxIndex + 1) / 7) * 100;
          const latestDate = item.date || item.lastUpdate || '';
          
          return `
