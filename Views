<script>
// ฟังก์ชันแม่พิมพ์: แปลงข้อมูล (Array) เป็น HTML ตาราง
function renderTableIntoContainer(data, containerId, columns) {
  const container = document.getElementById(containerId);
  if (!data || data.length === 0) {
    container.innerHTML = '<div class="text-center py-4 text-slate-400">ไม่มีข้อมูล</div>';
    return;
  }

  let html = `<table class="w-full text-sm text-left">
                <thead class="text-xs text-slate-500 uppercase bg-slate-50">
                  <tr>${columns.map(col => `<th class="px-4 py-3">${col}</th>`).join('')}</tr>
                </thead>
                <tbody class="divide-y divide-slate-100">`;

  data.forEach(row => {
    html += `<tr>${row.map(cell => `<td class="px-4 py-3 text-slate-600">${cell || '-'}</td>`).join('')}</tr>`;
  });

  html += `</tbody></table>`;
  container.innerHTML = html;
}


// ฟังก์ชันกลางสำหรับหย่อนข้อมูลลงกล่อง
function renderDataToDiv(data, containerId, columns) {
