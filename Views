<script>
  function loadRepairDataDirect() {
    document.getElementById('repGaugePath').style.strokeDashoffset = 125.6;

    google.script.run
      .withSuccessHandler(function(data) {
        if (!data) return;

        const total = data.total || 1;

        // 1. เลขตรงกลาง
        document.getElementById('repTotalText').innerText = data.total || 0;
        document.getElementById('repCompletedText').innerText = data.writeoffCount || 0;

        // เปลี่ยนข้อความคำบรรยายด้านล่างเลขกลาง
        const descElement = document.querySelector('.text-slate-500.mt-1');
        descElement.innerHTML = 'จาก <span id="repTotalText">' + (data.total || 0) + '</span> รายการ (จำหน่ายสำเร็จ)';

        // 2. สร้าง Categories (สป. สาย) อัตโนมัติ
        const catContainer = document.getElementById('dynamicCategoryContainer');
        if (data.categories && Object.keys(data.categories).length > 0) {
          catContainer.innerHTML = Object.entries(data.categories).map(([name, count]) => `
            <div class="text-center min-w-[35px]">
              <div class="text-[10px] text-slate-500 mb-0.5">${name}</div>
              <div class="text-base font-bold border-b-[2.5px] border-slate-700 inline-block px-1 leading-tight">${count}</div>
            </div>
          `).join('');
        }

        // 3. สร้าง Statuses (สถานะ) อัตโนมัติ พร้อมสลับสี
        const statContainer = document.getElementById('dynamicStatusContainer');
        const colorPalette = ['bg-amber-400', 'bg-blue-400', 'bg-rose-400', 'bg-indigo-400', 'bg-teal-400'];
        let colorIdx = 0;

        if (data.statuses && Object.keys(data.statuses).length > 0) {
          const sortedStatuses = Object.entries(data.statuses).sort((a, b) => b[1] - a[1]);
          
          statContainer.innerHTML = sortedStatuses.map(([name, count]) => {
            const pct = (count / total) * 100;
            const barColor = colorPalette[colorIdx % colorPalette.length];
            colorIdx++;
            return `
              <div>
                <div class="flex justify-between text-[10px] text-slate-600 mb-0.5">
                  <span class="truncate pr-2 flex items-center"><span class="w-1.5 h-1.5 rounded-full ${barColor} mr-1.5"></span>${name}</span>
                  <span class="font-bold">${count}</span>
                </div>
                <div class="w-full bg-slate-100 rounded-full h-1"><div class="${barColor} h-1 rounded-full" style="width: ${pct}%"></div></div>
              </div>
            `;
          }).join('');
        }

        // 4. แอนิเมชัน Gauge
        const percentWriteoff = Math.round(((data.writeoffCount || 0) / total) * 100);
        document.getElementById('repPercentText').innerText = percentWriteoff + '%';
        const offset = 125.6 * (1 - (percentWriteoff / 100));
        setTimeout(() => { document.getElementById('repGaugePath').style.strokeDashoffset = offset; }, 100);
      })
      .getRepairDashboardData();
  }

  setTimeout(loadRepairDataDirect, 800);
</script>

