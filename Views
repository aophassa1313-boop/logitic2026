  if (!data || data.length === 0) {
    container.innerHTML = '<div class="text-center py-4 text-slate-400">ไม่มีข้อมูล</div>';
    return;
  }

  // สร้างตารางจากข้อมูลที่ได้รับ
  let html = `<table class="w-full text-sm text-left">
                <thead class="text-xs text-slate-500 uppercase bg-slate-50">
                  <tr>${columns.map(col => `<th class="px-4 py-3">${col}</th>`).join('')}</tr>
                </thead>
                <tbody class="divide-y divide-slate-100">`;
  
  // ลูปข้อมูลใส่ตาราง
  data.forEach(row => {
    html += `<tr>${row.map(cell => `<td class="px-4 py-3 text-slate-600">${cell || '-'}</td>`).join('')}</tr>`;
  });
  html += `</tbody></table>`;
  
  container.innerHTML = html;
}
