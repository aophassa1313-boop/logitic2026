                  ${isFinished ? 'เสร็จสิ้น' : (item.maxIndex + 1) + '/7'}
                </span>
              </div>
              <div class="w-full bg-slate-200 rounded-full h-1 overflow-hidden">
                <div class="bg-blue-600 h-1 rounded-full" style="width: ${progressPercent}%"></div>
              </div>
              <div class="flex justify-between items-center mt-2">
                <div class="text-[11px] text-slate-600 truncate font-medium" title="${item.stepName}">
                  สถานะ: <span class="font-bold text-slate-800">${item.stepName}</span>
                </div>
