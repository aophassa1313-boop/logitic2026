<script>
  window.myRadarChartInstance = null;

  window.loadRadarDataDirect = function() {
    google.script.run
      .withSuccessHandler(function(response) {
        // เช็กว่ามี Error จาก Code.gs แจ้งมาหรือไม่
        if (response && response.error) {
          console.error("Error จาก Code.gs:", response.error);
          return;
        }

        // response ที่ได้มาจะเป็นข้อมูลดิบ (รายเรื่อง) เราต้องเอามานับแยกตามประเภท
        const typeCount = {};
        
        if (Array.isArray(response) && response.length > 0) {
          response.forEach(item => {
            const typeName = String(item.book_type || "").trim();
            if (typeName !== "") {
              typeCount[typeName] = (typeCount[typeName] || 0) + 1;
            }
          });
        }

        const labelsData = Object.keys(typeCount);
        const valuesData = Object.values(typeCount);

        // ถ้ามีข้อมูลให้นำไปวาดกราฟ ถ้าไม่มีให้โชว์ว่า "ไม่มีข้อมูล"
        if (labelsData.length > 0) {
          window.renderRadarChart(labelsData, valuesData);
        } else {
          window.renderRadarChart(["ไม่มีข้อมูล"], [0]);
        }
      })
      .withFailureHandler(function(err) {
        console.error("เกิดข้อผิดพลาดในการโหลดข้อมูลกราฟ:", err);
      })
      .getBookRadarData(); // 🔴 เรียกใช้ฟังก์ชันที่ท่านมีใน Code.gs
  };

  window.renderRadarChart = function(labelsData, valuesData) {
    if (typeof Chart === 'undefined') {
      console.error("ไม่พบไลบรารี Chart.js");
      return;
    }

    const canvas = document.getElementById('myRadarChart');
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    
    if (window.myRadarChartInstance) {
      window.myRadarChartInstance.destroy();
    }

    window.myRadarChartInstance = new Chart(ctx, {
      type: 'radar',
      data: {
        labels: labelsData,
        datasets: [{
          label: 'จำนวน (เรื่อง)',
          data: valuesData,
          backgroundColor: 'rgba(59, 130, 246, 0.2)', // สีฟ้าโปร่งใส
          borderColor: 'rgba(59, 130, 246, 1)',
          pointBackgroundColor: 'rgba(59, 130, 246, 1)',
          pointBorderColor: '#fff',
          pointHoverBackgroundColor: '#fff',
          pointHoverBorderColor: 'rgba(59, 130, 246, 1)'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false, // บังคับให้พอดีกรอบ 250px
        scales: {
          r: {
            angleLines: { display: true },
            suggestedMin: 0,
            ticks: { 
              stepSize: 1, 
              display: false 
            }
          }
        },
        plugins: {
          legend: { display: false } // ซ่อนคำอธิบายด้านบนเพื่อให้กราฟเด่นขึ้น
        }
      }
    });
  };

  document.addEventListener("DOMContentLoaded", function() {
    setTimeout(window.loadRadarDataDirect, 800);
  });
</script>

